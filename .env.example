# Supabase（必填）
NEXT_PUBLIC_SUPABASE_URL=https://你的项目id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 站点根 URL（OAuth 回跳用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== AI 智能体 (RAG) =====
# 大模型 API（OpenAI 兼容格式）
# 支持：OpenAI / DeepSeek / 通义千问 / 智谱 / OpenRouter / Groq 等
# 免费方案推荐：
#   - OpenRouter: https://openrouter.ai (注册送免费额度，可用 gemini 等)
#   - Google AI: https://aistudio.google.com (gemini-2.0-flash 免费)
# AI_API_KEY=sk-...
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# Embedding API（OpenAI 兼容格式）
# 免费方案推荐：
#   - DashScope 通义千问: https://dashscope.aliyun.com (注册送 100万 token/天)
#   - OpenRouter: 同上 key，模型用 openai/text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
